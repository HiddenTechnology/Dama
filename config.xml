<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:gravity="center"
	android:padding="24dp"
	android:background="#000000"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<TextView
		android:text="Configurar partida"
		android:textSize="28sp"
		android:textStyle="bold"
		android:textColor="#FF4219"
		android:fontFamily="monospace"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="24dp"/>

	<Button
		android:id="@+id/btTabuleiro"
		android:text="Tabuleiro: Original (Xadrez)"
		android:textSize="16sp"
		android:textColor="#39FF14"
		android:background="#0A0A0A"
		android:fontFamily="monospace"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginBottom="24dp"/>

	<Button
		android:id="@+id/btCor1"
		android:text="Cor Peça 1: Vermelho"
		android:textSize="16sp"
		android:textColor="#39FF14"
		android:background="#0A0A0A"
		android:fontFamily="monospace"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginBottom="24dp"/>

	<Button
		android:id="@+id/btCor2"
		android:text="Cor Peça 2: Preto"
		android:textSize="16sp"
		android:textColor="#39FF14"
		android:background="#0A0A0A"
		android:fontFamily="monospace"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginBottom="24dp"/>

	<Button
		android:id="@+id/btIniciar"
		android:text="@string/botao_iniciar"
		android:textSize="16sp"
		android:textColor="#39FF14"
		android:background="#0A0A0A"
		android:fontFamily="monospace"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginBottom="24dp"/>

</LinearLayout>

