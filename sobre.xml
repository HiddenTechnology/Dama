<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@android:drawable/ic_menu_compass"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Ícone do app"/>

        <TextView
            android:text="Dama"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF4219"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:text="Versão 3.5"
            android:textSize="14sp"
            android:textColor="#888888"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:text="DESENVOLVEDOR"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:text="Hidden Technology"
            android:textSize="18sp"
            android:textColor="#39FF14"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:text="github.com/HiddenTechnology/Dama"
            android:textSize="14sp"
            android:textColor="#39FF14"
            android:fontFamily="monospace"
            android:autoLink="web"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:text="© 2026 - Todos os direitos reservados"
            android:textSize="12sp"
            android:textColor="#666666"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:text="Um jogo de damas clássico com multiplayer local e efeito sonoros. Customize o tabuleiro e as peças, e divirta-se!"
            android:textSize="14sp"
            android:textColor="#39FF14"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btVoltar"
            android:text="Voltar ao Menu"
            android:textSize="16sp"
            android:textColor="#39FF14"
            android:background="#0a0a0a"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

</ScrollView>